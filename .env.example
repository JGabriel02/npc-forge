# Copie para .env e preencha. O .env nunca vai para o git.

# Senha do Postgres local. Use só letras e números: caracteres como ; " ' quebram
# a connection string montada no docker-compose.yml.
# Gere uma com: openssl rand -hex 16
POSTGRES_PASSWORD=

# Chave de assinatura do JWT: no mínimo 32 caracteres aleatórios.
# Gere uma com: openssl rand -base64 48
JWT_KEY=

# IA (opcional). Desligada, o app funciona normalmente com criação manual de NPCs.
# Para ligar, siga "Rodando com IA localmente" no README.
AI_ENABLED=false
OLLAMA_MODEL=qwen2.5:14b
# Só mude se usar o Ollama do docker compose (profile ollama-docker): http://ollama:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434
